worker_rank*.log

# Track curated regression baselines (all other *.h5 still ignored)
!tests/benchmark_data/benchmark_fmo7.h5
!tests/benchmark_data/benchmark_fmo7_n29.h5
!tests/benchmark_data/benchmark_fmo7_with_ground.h5
